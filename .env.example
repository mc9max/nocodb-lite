# NocoDB on Railway — env var reference
# The deploy form is zero-field: every variable below is auto-filled with a
# ${{...}} expression, and every other constant is baked into the images
# (Dockerfile ENV) or composed at boot by entrypoint.sh. Nothing needs
# typing in. Full upstream list:
# https://docs.nocodb.com/self-hosting/environment-variables

# --- Template variables (AUTO — all ${{...}} expressions) ---
# nocodb service:
PGHOST=                        # ${{postgres.RAILWAY_PRIVATE_DOMAIN}}
PGPASSWORD=                     # ${{postgres.POSTGRES_PASSWORD}}
NC_AUTH_JWT_SECRET=             # ${{secret(64)}}
# postgres service:
#   POSTGRES_PASSWORD=          # ${{secret(24)}}

# --- Baked into the images (Dockerfile ENV, never on the form) ---
# nocodb:   NC_DISABLE_TELE=true, PGUSER=nocodb, PGDATABASE=nocodb
# postgres: PGDATA=/var/lib/postgresql/data/pgdata, POSTGRES_USER=nocodb,
#           POSTGRES_DB=nocodb

# --- Composed at boot by entrypoint.sh ---
# NC_DB=pg://<PGHOST>:5432?u=nocodb&p=<PGPASSWORD>&d=nocodb
# (set NC_DB yourself to point at an external database instead)

# --- Useful optional upstream vars (add in the service Variables panel) ---
# NC_INVITE_ONLY_SIGNUP=true   # close sign-ups after creating your admin account
# NC_ADMIN_EMAIL=              # pre-seed admin email (with NC_ADMIN_PASSWORD)
# NC_ADMIN_PASSWORD=           # pre-seed admin password (skips the signup form)
# PORT=                        # Railway injects this; NocoDB honors it
